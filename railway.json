{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": [
      "python -u run_railway.py migrate"
    ],
    "startCommand": "python -u run_railway.py worker --once --allow-source-failures",
    "cronSchedule": "*/10 * * * *",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
